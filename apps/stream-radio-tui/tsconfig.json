{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    // the mod's core, which the TUI shares: esbuild and vitest.config.ts read this too
    "paths": { "@core/*": ["../../plugins/stream-radio/core/*"] }
  },
  "include": ["src", "test", "vitest.config.ts", "../../plugins/stream-radio/core"],
  "exclude": ["../../plugins/stream-radio/core/**/*.test.ts", "node_modules"]
}
